---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSummary, getVisiblePosts, toDateLabel } from "@/lib/utils";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = post.data.tags ?? [];

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt ?? getSummary(post.body)}
>
  <article>
    <a class="post-back" href="/">← Archive</a>

    <div class="post-header">
      {
        tags.length > 0 && (
          <div class="label-tag">
            {tags.map((t, i) => (
              <>
                <a href={`/tags/${t}/`} class="post-tag-inline">
                  #{t}
                </a>
                {i < tags.length - 1 ? " · " : ""}
              </>
            ))}
          </div>
        )
      }
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-meta">
        <span>{toDateLabel(post.data.date)}</span>
        <span>·</span>
        <span>{readMinutes} min</span>
        {
          post.data.updatedDate && (
            <>
              <span>·</span>
              <span>Updated {toDateLabel(post.data.updatedDate)}</span>
            </>
          )
        }
      </div>
      <div class="article-divider">
        <hr />✦<hr />
      </div>
    </div>

    <div class="post-body">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="post-tags-footer">
          {tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="post-tag-inline">
              #{tag}
            </a>
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>
