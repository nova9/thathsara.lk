---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getVisiblePosts, toDateLabel } from "@/lib/utils";

const posts = (await getVisiblePosts()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Posts">
  <h1 class="page-title">All Posts</h1>

  <ul class="posts">
    {
      posts.map((post) => (
        <li
          class="post"
          style={
            post.data.accentColor
              ? `--color-primary: ${post.data.accentColor}; --color-border: ${post.data.accentColor};`
              : undefined
          }
        >
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <span class="meta"> {toDateLabel(post.data.date)}</span>
        </li>
      ))
    }
  </ul>


</BaseLayout>
