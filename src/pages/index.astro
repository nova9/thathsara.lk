---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Newsletter from "@/components/Newsletter.astro";
import { siteConfig } from "@/lib/site";
import { getAllPosts, toDateLabel } from "@/lib/utils";

const posts = await getAllPosts();
const featuredPosts = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);
---

<BaseLayout description={siteConfig.description}>
  {featuredPosts.map((featured) => (
    <section class="hero">
      <div class="label-tag">Featured Dispatch</div>
      <h1 class="hero-title">{featured.data.title}</h1>
      {featured.data.excerpt && (
        <p class="hero-excerpt">{featured.data.excerpt}</p>
      )}
      <a class="read-link" href={`/posts/${featured.id}/`}>
        Read in full →
      </a>
    </section>
  ))}

  <div class="section-hd">
    <hr />
    <span class="section-lbl">All Dispatches</span>
    <hr />
  </div>

  {rest.map((post) => <PostCard post={post} />)}

  <Newsletter />
</BaseLayout>
