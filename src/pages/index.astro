---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import UnreadBadge from "@/components/UnreadBadge.astro";
import { siteConfig } from "@/lib/site";
import { getAllPosts, toDateLabel } from "@/lib/utils";

const posts = await getAllPosts();
const featuredPosts = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);
---

<BaseLayout description={siteConfig.description}>
  {featuredPosts.map((featured) => (
    <section class="hero">
      <div class="label-tag">
        Featured Dispatch
        <UnreadBadge postId={featured.id} />
      </div>
      <h1 class="hero-title"><a href={`/posts/${featured.id}/`}>{featured.data.title}</a></h1>
      {featured.data.excerpt && (
        <p class="hero-excerpt">{featured.data.excerpt}</p>
      )}
    </section>
  ))}

  <div class="section-hd">
    <hr />
    <span class="section-lbl">All Dispatches</span>
    <hr />
  </div>

  {rest.map((post) => <PostCard post={post} />)}
</BaseLayout>
