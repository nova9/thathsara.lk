---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getVisiblePosts } from "@/lib/utils";

const posts = await getVisiblePosts();
const tagCounts: Record<string, number> = {};
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags">
  <div class="section-hd" style="padding-top: 3rem;">
    <hr />
    <span class="section-lbl">All Tags</span>
    <hr />
  </div>

  <div class="tags-cloud">
    {tags.map(([tag, count]) => (
      <a class="tag-pill" href={`/tags/${tag}/`}>
        #{tag}
        <span style="margin-left: 4px; opacity: 0.6; font-size: 8px;">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>
