---
import dotlottieWasmUrl from "@lottiefiles/dotlottie-web/dotlottie-player.wasm?url";
---

<script is:inline define:vars={{ wasmUrl: dotlottieWasmUrl }}>
  function prefetchLottieAssets() {
    const load = () => {
      fetch(wasmUrl, { priority: "low" }).catch(() => {});
    };
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(load, { timeout: 5000 });
    } else {
      setTimeout(load, 5000);
    }
  }

  document.addEventListener("astro:page-load", prefetchLottieAssets);
</script>
