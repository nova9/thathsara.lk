---
// Per-article reading-progress bar.
//
// A thin gold rule pinned to the top of the viewport that fills as you read
// down the page. Built entirely with a CSS scroll-driven animation
// (`animation-timeline: scroll()`), so it ships ZERO JavaScript — in keeping
// with the rest of the site, nothing runs in the browser to make it work.
//
// Browsers without scroll-driven animations simply don't render it (guarded by
// `@supports`), so there's never a broken, perpetually-empty bar.
//
// Sits just under the transient route-loading bar in BaseLayout (z-index 99999),
// which briefly overlays it during navigation and then fades.
---

<div class="reading-progress" aria-hidden="true"></div>

<style>
  .reading-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @keyframes reading-progress-grow {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    .reading-progress {
      display: block;
      position: fixed;
      inset-block-start: 0;
      inset-inline-start: 0;
      inline-size: 100%;
      block-size: 2px;
      z-index: 9990;
      pointer-events: none;
      background: var(--color-gold);
      transform: scaleX(0);
      transform-origin: 0 50%;
      will-change: transform;

      animation: reading-progress-grow linear both;
      animation-timeline: scroll(root block);
    }
  }
</style>
