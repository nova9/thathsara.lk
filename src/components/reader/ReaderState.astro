---
// Reconciles `reader:unlocked` against the current set of visible posts.
// If a newly published post means the claim no longer holds, clear it.
// `reader:read` is preserved — returning readers don't re-scroll posts
// they've already finished.
//
// The earning side of `reader:unlocked` lives in ReaderSentinel.astro.

import { getVisiblePosts } from "@/lib/utils";

const allPostIds = (await getVisiblePosts()).map((p) => p.id);
---

<div id="reader-state" data-all-posts={JSON.stringify(allPostIds)} hidden></div>

<script>
  import { unlocked, hasReadAll } from "@/lib/readerState";

  function reconcile() {
    if (!unlocked.get()) return;

    const el = document.getElementById("reader-state");
    if (!el) return;

    const allPosts: string[] = JSON.parse(el.dataset.allPosts || "[]");
    if (!hasReadAll(allPosts)) unlocked.set(false);
  }

  document.addEventListener("astro:page-load", reconcile);
</script>
