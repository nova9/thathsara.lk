---
import Loader from "./Loader.astro";
import PauseIcon from "./icons/PauseIcon.astro";
import PlayIcon from "./icons/PlayIcon.astro";

export interface Props {
  src?: string;
  manifestUrl?: string;
  poster?: string;
  title?: string;
}

const { src, manifestUrl, poster, title } = Astro.props;
const id = Math.random().toString(36).substring(2, 11);
---

<div
  class="video-player"
  id={`player-${id}`}
  data-src={src}
  data-manifest={manifestUrl}
>
  <dash-video id={`media-${id}`}>
    <video poster={poster} playsinline preload="metadata" loop></video>
  </dash-video>

  {title && <div class="video-title">{title}</div>}

  <!-- Center Play Button -->
  <button type="button" class="video-center-play" aria-label="Play Video">
    <PlayIcon class="icon-play-large" />
    <Loader size="2rem" hidden />
  </button>

  <div class="video-controls">
    <!-- Full-width timeline above buttons -->
    <div class="video-timeline-container">
      <input
        type="range"
        class="video-timeline"
        min="0"
        max="100"
        value="0"
        step="0.1"
        aria-label="Video timeline"
      />
      <div class="video-progress-bar"></div>
    </div>

    <!-- Button row -->
    <div class="video-buttons-row">
      <button
        type="button"
        class="video-btn play-pause-btn"
        aria-label="Play/Pause"
      >
        <PlayIcon class="icon-play" />
        <PauseIcon class="icon-pause" />
      </button>

      <div class="video-time">
        <span class="time-current">0:00</span>
        <span class="time-separator">/</span>
        <span class="time-duration">0:00</span>
      </div>

      <div class="video-spacer"></div>

      <div class="video-quality-container" style="display: none;">
        <div class="video-quality-select">
          <button class="video-quality-btn" type="button" aria-label="Quality"
            >Auto</button
          >
          <ul class="video-quality-menu"></ul>
        </div>
      </div>

      <button type="button" class="video-btn mute-btn" aria-label="Toggle Mute">
        <svg
          class="icon-volume"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M11 5L6.5 9.5H3v5h3.5L11 19z"></path>
          <path d="M15 9a4 4 0 0 1 0 6"></path>
          <path d="M17.5 6.5a7.5 7.5 0 0 1 0 11"></path>
        </svg>
        <svg
          class="icon-muted"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display: none;"
        >
          <path d="M11 5L6.5 9.5H3v5h3.5L11 19z"></path>
          <path d="M16 9.5l5 5M21 9.5l-5 5"></path>
        </svg>
      </button>

      <div class="video-volume-container">
        <input
          type="range"
          class="video-volume"
          min="0"
          max="1"
          step="0.05"
          value="1"
          aria-label="Volume"
        />
      </div>

      <button
        type="button"
        class="video-btn fullscreen-btn"
        aria-label="Fullscreen"
      >
        <svg
          class="icon-fullscreen"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
        </svg>
        <svg
          class="icon-fullscreen-exit"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display: none;"
        >
          <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style lang="scss">
  .video-player {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: var(--border-radius, 10px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    font-family: var(--font-body, inherit);
    user-select: none;
    color-scheme: dark;

    &:fullscreen,
    &:-webkit-full-screen {
      border-radius: 0;

      dash-video {
        flex: 1;
        min-height: 0;
      }

      video {
        width: 100%;
        height: 100%;
      }
    }
  }

  dash-video {
    display: block;
    width: 100%;
    background: #000;
  }

  video {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  video::-webkit-media-controls {
    display: none !important;
  }

  .video-title {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1rem 1rem 2.5rem;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.65) 0%,
      transparent 100%
    );
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 10;
  }

  .video-player.show-ui .video-title {
    opacity: 1;
  }

  @media (hover: hover) {
    .video-player:hover .video-title {
      opacity: 1;
    }
  }

  .icon-play {
    display: block;
  }

  .icon-pause {
    display: none;
  }

  // Center play button
  .video-center-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    border-radius: 50%;
    width: 4.5rem;
    height: 4.5rem;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.25s ease;

    @media (hover: hover) {
      &:hover {
        transform: translate(-50%, -50%) scale(1.1);
        background: rgba(0, 0, 0, 0.65);
        border-color: rgba(255, 255, 255, 0.45);
      }
    }

    svg {
      width: 2rem;
      height: 2rem;
      pointer-events: none;
    }

    &.fade-out {
      opacity: 0;
      pointer-events: none;
    }
  }

  // Controls overlay
  .video-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 0rem 0.5rem 0.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.5) 45%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.25s ease;

    .video-player.show-ui & {
      opacity: 1;
    }

    @media (hover: hover) {
      .video-player:hover & {
        opacity: 1;
      }
    }
  }

  // Timeline row
  .video-timeline-container {
    position: relative;
    height: 1.25rem;
    display: flex;
    align-items: center;
    cursor: pointer;

    // CSS thumb dot that appears on hover
    &::after {
      content: "";
      position: absolute;
      left: var(--progress, 0%);
      top: 50%;
      transform: translate(-50%, -50%) scale(0);
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: #fff;
      pointer-events: none;
      z-index: 3;
      transition: transform 0.15s ease;
    }

    @media (hover: hover) {
      &:hover::after {
        transform: translate(-50%, -50%) scale(1);
      }

      &:hover .video-progress-bar {
        height: 5px;
      }
    }
  }

  .video-timeline {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
    margin: 0;
    padding: 0;
  }

  .video-progress-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.22);
    border-radius: 3px;
    transition: height 0.2s ease;
    z-index: 1;
    pointer-events: none;

    // Progress fill
    &::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: var(--progress, 0%);
      background: var(--color-primary, #fff);
      border-radius: inherit;
      z-index: 2;
    }

    // Buffer fill
    &::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: var(--buffer, 0%);
      background: rgba(255, 255, 255, 0.35);
      border-radius: inherit;
      z-index: 1;
    }
  }

  // Button row
  .video-buttons-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .video-spacer {
    flex: 1;
  }

  .video-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    width: 1.875rem;
    height: 1.875rem;
    transition:
      color 0.15s ease,
      transform 0.15s ease;
    flex-shrink: 0;
    border-radius: 4px;

    svg {
      width: 1.25rem;
      height: 1.25rem;
      pointer-events: none;
    }

    @media (hover: hover) {
      &:hover {
        color: #fff;
        transform: scale(1.15);
      }
    }
  }

  .video-time {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    user-select: none;
    display: flex;
    gap: 0.2rem;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  .time-separator {
    opacity: 0.45;
  }

  // Volume slider
  .video-volume-container {
    width: 4.5rem;
    display: flex;
    align-items: center;

    .video-volume {
      width: 100%;
      height: 3px;
      -webkit-appearance: none;
      appearance: none;
      background: linear-gradient(
        to right,
        #fff var(--vol, 100%),
        rgba(255, 255, 255, 0.28) var(--vol, 100%)
      );
      border-radius: 3px;
      outline: none;
      cursor: pointer;
      transition: height 0.2s ease;
      border: none;
      padding: 0;

      &::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #fff;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s ease;
      }

      @media (hover: hover) {
        &:hover {
          height: 5px;
        }

        &:hover::-webkit-slider-thumb {
          opacity: 1;
        }
      }

      &::-moz-range-thumb {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #fff;
        border: none;
        cursor: pointer;
      }
    }
  }

  // Quality selector
  .video-quality-container {
    display: flex;
    align-items: center;

    .video-quality-select {
      display: flex;
      align-items: center;
      position: relative;
    }

    .video-quality-btn {
      appearance: none;
      -webkit-appearance: none;
      background: rgba(255, 255, 255, 0.12);
      color: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      padding: 0.25rem 0.25rem 0.2rem;
      font-size: 0.68rem;
      font-family: monospace;
      letter-spacing: 0.03em;
      text-indent: 0.03em;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      outline: none;
      transition:
        background 0.15s ease,
        border-color 0.15s ease;

      @media (hover: hover) {
        &:hover {
          background: rgba(255, 255, 255, 0.22);
          border-color: rgba(255, 255, 255, 0.4);
          color: #fff;
        }
      }
    }

    .video-quality-menu {
      position: absolute;
      bottom: calc(100% + 6px);
      right: 0;
      background: rgba(18, 18, 18, 0.97);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
      list-style: none;
      margin: 0;
      padding: 0.3rem 0;
      min-width: 4.5rem;
      z-index: 100;
      display: none;

      &.open {
        display: block;
      }

      :global(li) {
        padding: 0.35rem 0.85rem;
        font-size: 0.68rem;
        font-family: monospace;
        color: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        white-space: nowrap;
        transition:
          background 0.12s ease,
          color 0.12s ease;

        @media (hover: hover) {
          &:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
          }
        }
      }

      :global(li.selected) {
        color: #fff;
        font-weight: 600;
      }
    }
  }

  // Mobile
  @media (max-width: 40rem) {
    .video-volume-container {
      display: none;
    }

    .video-time {
      font-size: 0.67rem;
    }

    .video-btn {
      width: 1.625rem;
      height: 1.625rem;
      padding: 0.15rem;
    }

    .video-center-play {
      width: 4rem;
      height: 4rem;
      padding: 1rem;

      svg {
        width: 1.625rem;
        height: 1.625rem;
      }
    }
  }
</style>

<script>
  import "@/scripts/dash-video.js";
</script>

<script>
  // @ts-nocheck
  function showOnly(showEl, hideEl) {
    showEl.style.display = "block";
    hideEl.style.display = "none";
  }

  function isFullscreen() {
    return !!(document.fullscreenElement || document.webkitFullscreenElement);
  }

  function formatTime(seconds) {
    if (isNaN(seconds)) return "0:00";
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${s.toString().padStart(2, "0")}`;
  }

  class VideoController {
    constructor(player) {
      this.player = player;
      this.dashVideo = player.querySelector("dash-video");
      this.video = this.dashVideo.querySelector("video");

      this.centerPlayBtn = player.querySelector(".video-center-play");
      this.centerPlayIcon =
        this.centerPlayBtn.querySelector(".icon-play-large");
      this.centerLoadingIcon = this.centerPlayBtn.querySelector(".loader");

      this.playPauseBtn = player.querySelector(".play-pause-btn");
      this.iconPlay = this.playPauseBtn.querySelector(".icon-play");
      this.iconPause = this.playPauseBtn.querySelector(".icon-pause");

      this.muteBtn = player.querySelector(".mute-btn");
      this.iconVol = this.muteBtn.querySelector(".icon-volume");
      this.iconMuted = this.muteBtn.querySelector(".icon-muted");

      this.fullscreenBtn = player.querySelector(".fullscreen-btn");
      this.iconFullscreen =
        this.fullscreenBtn.querySelector(".icon-fullscreen");
      this.iconFullscreenExit = this.fullscreenBtn.querySelector(
        ".icon-fullscreen-exit",
      );

      this.timelineContainer = player.querySelector(
        ".video-timeline-container",
      );
      this.timeline = player.querySelector(".video-timeline");
      this.progressBar = player.querySelector(".video-progress-bar");
      this.timeCurrent = player.querySelector(".time-current");
      this.timeDuration = player.querySelector(".time-duration");

      this.volumeSlider = player.querySelector(".video-volume");
      this.qualityContainer = player.querySelector(".video-quality-container");
      this.qualityBtn = player.querySelector(".video-quality-btn");
      this.qualityMenu = player.querySelector(".video-quality-menu");

      this.src = player.dataset.src;
      this.manifest = player.dataset.manifest;
      this.isVideoLoaded = false;
      this.hideUiTimeout = null;

      this.bindEvents();
      this.player.classList.add("show-ui");

      if (this.src && !this.manifest) {
        this.video.src = this.src;
      }
    }

    bindEvents() {
      this.player.addEventListener("mousemove", () => this.scheduleUiHide());
      this.player.addEventListener("mouseleave", () => {
        if (!this.video.paused) this.player.classList.remove("show-ui");
      });

      const toggle = () => this.togglePlay();
      this.centerPlayBtn.addEventListener("click", () => toggle());
      this.playPauseBtn.addEventListener("click", () => toggle());
      this.video.addEventListener("click", () => toggle());

      this.dashVideo.addEventListener("play", () => this.onPlay());
      this.dashVideo.addEventListener("pause", () => this.onPause());
      this.dashVideo.addEventListener("waiting", () =>
        this.setCenterLoading(true),
      );
      this.dashVideo.addEventListener("playing", () => {
        this.setCenterLoading(false);
        this.centerPlayBtn.classList.add("fade-out");
      });
      this.dashVideo.addEventListener("loadedmetadata", () => {
        this.timeDuration.textContent = formatTime(this.video.duration);
      });
      this.dashVideo.addEventListener("timeupdate", () => {
        this.timeCurrent.textContent = formatTime(this.video.currentTime);
        this.updateProgressAndBuffer();
      });
      this.dashVideo.addEventListener("progress", () =>
        this.updateProgressAndBuffer(),
      );
      this.dashVideo.addEventListener("volumechange", () =>
        this.updateVolumeUi(),
      );
      this.dashVideo.addEventListener("shakaready", () =>
        this.populateQualityMenu(),
      );

      this.timeline.addEventListener("input", (e) => {
        if (this.video.duration) {
          this.video.currentTime = (e.target.value / 100) * this.video.duration;
        }
      });

      this.muteBtn.addEventListener("click", () => {
        this.video.muted = !this.video.muted;
        this.volumeSlider.value = this.video.muted ? 0 : this.video.volume;
        this.updateVolumeUi();
      });

      this.volumeSlider.addEventListener("input", (e) => {
        this.video.volume = e.target.value;
        this.video.muted = this.video.volume === 0;
        this.updateVolumeUi();
      });

      this.qualityBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.qualityMenu.classList.toggle("open");
      });

      this.qualityMenu?.addEventListener("click", (e) => {
        const li = e.target.closest("li");
        if (!li) return;
        this.qualityMenu
          .querySelectorAll("li")
          .forEach((el) => el.classList.remove("selected"));
        li.classList.add("selected");
        this.qualityBtn.textContent = li.textContent;
        this.qualityMenu.classList.remove("open");
        this.dashVideo.selectTrack(li.dataset.value);
      });

      document.addEventListener("click", () => {
        this.qualityMenu?.classList.remove("open");
      });

      this.fullscreenBtn.addEventListener("click", () =>
        this.toggleFullscreen(),
      );

      const onFsChange = () => this.updateFullscreenIcon();
      document.addEventListener("fullscreenchange", onFsChange);
      document.addEventListener("webkitfullscreenchange", onFsChange);

      // iOS fires these on <video> when using webkitEnterFullscreen
      this.video.addEventListener("webkitbeginfullscreen", () => {
        showOnly(this.iconFullscreenExit, this.iconFullscreen);
      });
      this.video.addEventListener("webkitendfullscreen", () => {
        showOnly(this.iconFullscreen, this.iconFullscreenExit);
      });
    }

    scheduleUiHide() {
      clearTimeout(this.hideUiTimeout);
      this.player.classList.add("show-ui");
      if (!this.video.paused) {
        this.hideUiTimeout = setTimeout(() => {
          this.player.classList.remove("show-ui");
        }, 3000);
      }
    }

    setCenterLoading(loading) {
      if (loading) {
        this.centerPlayBtn.classList.remove("fade-out");
        showOnly(this.centerLoadingIcon, this.centerPlayIcon);
      } else {
        showOnly(this.centerPlayIcon, this.centerLoadingIcon);
      }
    }

    async togglePlay() {
      if (!this.isVideoLoaded) {
        this.setCenterLoading(true);
        await this.dashVideo.loadVideo(this.manifest, this.src);
        this.isVideoLoaded = true;
        this.setCenterLoading(false);
      }
      if (this.video.paused) {
        this.video.play().catch((e) => console.error("Video play blocked:", e));
      } else {
        this.video.pause();
      }
    }

    onPlay() {
      showOnly(this.iconPause, this.iconPlay);
      this.centerPlayBtn.classList.add("fade-out");
      this.scheduleUiHide();
      document.dispatchEvent(
        new CustomEvent("media-playback-started", {
          detail: { source: "video", id: this.player.id },
        }),
      );
    }

    onPause() {
      showOnly(this.iconPlay, this.iconPause);
      this.centerPlayBtn.classList.remove("fade-out");
      this.player.classList.add("show-ui");
    }

    updateProgressAndBuffer() {
      if (!this.video.duration) return;
      const percent = (this.video.currentTime / this.video.duration) * 100;
      this.timeline.value = percent;
      this.progressBar.style.setProperty("--progress", `${percent}%`);
      // Container also reads --progress for the CSS thumb pseudo-element.
      this.timelineContainer.style.setProperty("--progress", `${percent}%`);

      const buffered = this.video.buffered;
      if (buffered.length === 0) return;

      let bufEnd = 0;
      for (let i = 0; i < buffered.length; i++) {
        if (
          buffered.start(i) <= this.video.currentTime &&
          buffered.end(i) >= this.video.currentTime
        ) {
          bufEnd = buffered.end(i);
          break;
        }
      }
      if (bufEnd === 0) {
        bufEnd = buffered.end(buffered.length - 1);
      }
      const bufPercent = (bufEnd / this.video.duration) * 100;
      this.progressBar.style.setProperty("--buffer", `${bufPercent}%`);
    }

    updateVolumeUi() {
      const vol = this.video.muted ? 0 : this.video.volume;
      this.volumeSlider.value = vol;
      this.volumeSlider.style.setProperty("--vol", `${vol * 100}%`);
      if (this.video.volume === 0 || this.video.muted) {
        showOnly(this.iconMuted, this.iconVol);
      } else {
        showOnly(this.iconVol, this.iconMuted);
      }
    }

    populateQualityMenu() {
      const tracks = this.dashVideo.getTracks();
      if (!tracks || tracks.length === 0) return;

      const seenHeights = new Set();
      const uniqueTracks = tracks
        .filter((t) => {
          if (t.height && !seenHeights.has(t.height)) {
            seenHeights.add(t.height);
            return true;
          }
          return false;
        })
        .sort((a, b) => b.height - a.height);

      if (uniqueTracks.length <= 1) return;

      this.qualityMenu.innerHTML =
        '<li data-value="auto" class="selected">Auto</li>';
      uniqueTracks.forEach((t) => {
        const li = document.createElement("li");
        li.dataset.value = t.id;
        li.textContent = `${t.height}p`;
        this.qualityMenu.appendChild(li);
      });
      this.qualityContainer.style.display = "flex";
    }

    toggleFullscreen() {
      if (isFullscreen()) {
        (document.exitFullscreen || document.webkitExitFullscreen).call(
          document,
        );
      } else if (this.player.requestFullscreen) {
        this.player.requestFullscreen().catch((err) => {
          console.error(
            `Error attempting to enable full-screen mode: ${err.message}`,
          );
        });
      } else if (this.player.webkitRequestFullscreen) {
        this.player.webkitRequestFullscreen();
      } else if (this.video.webkitEnterFullscreen) {
        // iOS Safari: only <video> itself can go fullscreen
        this.video.webkitEnterFullscreen();
      }
    }

    updateFullscreenIcon() {
      const fs = isFullscreen();
      this.iconFullscreen.style.display = fs ? "none" : "block";
      this.iconFullscreenExit.style.display = fs ? "block" : "none";
    }
  }

  function setupVideoPlayers() {
    document.querySelectorAll(".video-player").forEach((player) => {
      if (!player._controller) {
        player._controller = new VideoController(player);
      }
    });
  }

  function initVideoPlayers() {
    if ("requestIdleCallback" in window) {
      requestIdleCallback(setupVideoPlayers);
    } else {
      setTimeout(setupVideoPlayers, 1);
    }
  }

  document.addEventListener("DOMContentLoaded", initVideoPlayers);
  document.addEventListener("astro:page-load", initVideoPlayers);
</script>
