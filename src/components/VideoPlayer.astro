---
export interface Props {
  src?: string;
  manifestUrl?: string;
  poster?: string;
  title?: string;
}

const { src, manifestUrl, poster, title } = Astro.props;
const id = Math.random().toString(36).substring(2, 11);
---

<div
  class="video-player"
  id={`player-${id}`}
  data-src={src}
  data-manifest={manifestUrl}
>
  <dash-video id={`media-${id}`}>
    <video poster={poster} playsinline preload="metadata"></video>
  </dash-video>

  {title && <div class="video-title">{title}</div>}

  <!-- Center Play Button -->
  <button type="button" class="video-center-play" aria-label="Play Video">
    <svg
      class="icon-play-large"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M8 5v14l11-7z"></path>
    </svg>
    <svg
      class="icon-loading-large"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 50 50"
      fill="none"
      style="display: none;"
    >
      <circle
        cx="25"
        cy="25"
        r="20"
        stroke="currentColor"
        stroke-width="5"
        opacity="0.25"></circle>
      <path
        d="M45 25a20 20 0 1 1-20-20"
        stroke="currentColor"
        stroke-width="5"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <div class="video-controls">
    <!-- Full-width timeline above buttons -->
    <div class="video-timeline-container">
      <input
        type="range"
        class="video-timeline"
        min="0"
        max="100"
        value="0"
        step="0.1"
        aria-label="Video timeline"
      />
      <div class="video-progress-bar"></div>
    </div>

    <!-- Button row -->
    <div class="video-buttons-row">
      <button type="button" class="video-btn play-pause-btn" aria-label="Play/Pause">
        <svg
          class="icon-play"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg
          class="icon-pause"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="display: none;"
        >
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
        </svg>
      </button>

      <div class="video-time">
        <span class="time-current">0:00</span>
        <span class="time-separator">/</span>
        <span class="time-duration">0:00</span>
      </div>

      <div class="video-spacer"></div>

      <div class="video-quality-container" style="display: none;">
        <div class="video-quality-select">
          <button class="video-quality-btn" type="button" aria-label="Quality">Auto</button>
          <ul class="video-quality-menu"></ul>
        </div>
      </div>

      <button type="button" class="video-btn mute-btn" aria-label="Toggle Mute">
        <svg
          class="icon-volume"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
          ></path>
        </svg>
        <svg
          class="icon-muted"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="display: none;"
        >
          <path
            d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
          ></path>
        </svg>
      </button>

      <div class="video-volume-container">
        <input
          type="range"
          class="video-volume"
          min="0"
          max="1"
          step="0.05"
          value="1"
          aria-label="Volume"
        />
      </div>

      <button type="button" class="video-btn fullscreen-btn" aria-label="Fullscreen">
        <svg
          class="icon-fullscreen"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
          ></path>
        </svg>
        <svg
          class="icon-fullscreen-exit"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="display: none;"
        >
          <path
            d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style lang="scss">
  .video-player {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: var(--border-radius, 10px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    font-family: var(--font-body, inherit);
    user-select: none;
    color-scheme: dark;

    &:fullscreen {
      border-radius: 0;
    }
  }

  dash-video {
    display: block;
    width: 100%;
    background: #000;
  }

  video {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  video::-webkit-media-controls {
    display: none !important;
  }

  .video-title {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1rem 1rem 2.5rem;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.65) 0%, transparent 100%);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 10;
  }

  .video-player.show-ui .video-title,
  .video-player:hover .video-title {
    opacity: 1;
  }

  // Center play button
  .video-center-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    border-radius: 50%;
    width: 4.5rem;
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 15;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.25s ease;
    padding: 0;

    @media (hover: hover) {
      &:hover {
        transform: translate(-50%, -50%) scale(1.1);
        background: rgba(0, 0, 0, 0.65);
        border-color: rgba(255, 255, 255, 0.45);
      }
    }

    svg {
      width: 2rem;
      height: 2rem;
      pointer-events: none;
    }

    &.fade-out {
      opacity: 0;
      pointer-events: none;
    }
  }

  .icon-loading-large {
    animation: video-spin 0.8s linear infinite;
  }

  @keyframes video-spin {
    to {
      transform: rotate(360deg);
    }
  }

  // Controls overlay
  .video-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 4rem 0.875rem 0.625rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.5) 45%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.25s ease;

    .video-player.show-ui &,
    .video-player:hover & {
      opacity: 1;
    }
  }

  // Timeline row
  .video-timeline-container {
    position: relative;
    height: 1.25rem;
    display: flex;
    align-items: center;
    cursor: pointer;

    // CSS thumb dot that appears on hover
    &::after {
      content: "";
      position: absolute;
      left: var(--progress, 0%);
      top: 50%;
      transform: translate(-50%, -50%) scale(0);
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: #fff;
      pointer-events: none;
      z-index: 3;
      transition: transform 0.15s ease;
    }

    &:hover::after {
      transform: translate(-50%, -50%) scale(1);
    }

    &:hover .video-progress-bar {
      height: 5px;
    }
  }

  .video-timeline {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
    margin: 0;
    padding: 0;
  }

  .video-progress-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.22);
    border-radius: 3px;
    transition: height 0.2s ease;
    z-index: 1;
    pointer-events: none;

    // Progress fill
    &::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: var(--progress, 0%);
      background: var(--color-primary, #fff);
      border-radius: inherit;
      z-index: 2;
    }

    // Buffer fill
    &::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: var(--buffer, 0%);
      background: rgba(255, 255, 255, 0.35);
      border-radius: inherit;
      z-index: 1;
    }
  }

  // Button row
  .video-buttons-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .video-spacer {
    flex: 1;
  }

  .video-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    width: 1.875rem;
    height: 1.875rem;
    transition:
      color 0.15s ease,
      transform 0.15s ease;
    flex-shrink: 0;
    border-radius: 4px;

    svg {
      width: 1.25rem;
      height: 1.25rem;
      pointer-events: none;
    }

    @media (hover: hover) {
      &:hover {
        color: #fff;
        transform: scale(1.15);
      }
    }
  }

  .video-time {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    user-select: none;
    display: flex;
    gap: 0.2rem;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  .time-separator {
    opacity: 0.45;
  }

  // Volume slider
  .video-volume-container {
    width: 4.5rem;
    display: flex;
    align-items: center;

    .video-volume {
      width: 100%;
      height: 3px;
      -webkit-appearance: none;
      appearance: none;
      background: linear-gradient(
        to right,
        #fff var(--vol, 100%),
        rgba(255, 255, 255, 0.28) var(--vol, 100%)
      );
      border-radius: 3px;
      outline: none;
      cursor: pointer;
      transition: height 0.2s ease;
      border: none;
      padding: 0;

      &:hover {
        height: 5px;
      }

      &::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #fff;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s ease;
      }

      &:hover::-webkit-slider-thumb {
        opacity: 1;
      }

      &::-moz-range-thumb {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #fff;
        border: none;
        cursor: pointer;
      }
    }
  }

  // Quality selector
  .video-quality-container {
    display: flex;
    align-items: center;

    .video-quality-select {
      position: relative;
    }

    .video-quality-btn {
      appearance: none;
      -webkit-appearance: none;
      background: rgba(255, 255, 255, 0.12);
      color: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      padding: 0.2rem 0.5rem;
      font-size: 0.68rem;
      font-family: monospace;
      letter-spacing: 0.03em;
      line-height: 1;
      cursor: pointer;
      outline: none;
      transition: background 0.15s ease, border-color 0.15s ease;

      @media (hover: hover) {
        &:hover {
          background: rgba(255, 255, 255, 0.22);
          border-color: rgba(255, 255, 255, 0.4);
          color: #fff;
        }
      }
    }

    .video-quality-menu {
      position: absolute;
      bottom: calc(100% + 6px);
      right: 0;
      background: rgba(18, 18, 18, 0.97);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
      list-style: none;
      margin: 0;
      padding: 0.3rem 0;
      min-width: 4.5rem;
      z-index: 100;
      display: none;

      &.open {
        display: block;
      }

      :global(li) {
        padding: 0.35rem 0.85rem;
        font-size: 0.68rem;
        font-family: monospace;
        color: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.12s ease, color 0.12s ease;

        &:hover {
          background: rgba(255, 255, 255, 0.1);
          color: #fff;
        }
      }

      :global(li.selected) {
        color: #fff;
        font-weight: 600;
      }
    }
  }

  // Mobile
  @media (max-width: 40rem) {
    .video-volume-container {
      display: none;
    }

    .video-time {
      font-size: 0.67rem;
    }

    .video-btn {
      width: 1.625rem;
      height: 1.625rem;
      padding: 0.15rem;
    }

    .video-center-play {
      width: 3.75rem;
      height: 3.75rem;

      svg {
        width: 1.625rem;
        height: 1.625rem;
      }
    }
  }
</style>

<script is:inline>
  class DashVideo extends HTMLElement {
    constructor() {
      super();
      this.video = this.querySelector("video");
      this.shakaPlayer = null;
      this.shakaPromise = null;
    }

    async getShaka() {
      if (window.shaka) return window.shaka;
      if (this.shakaPromise) return this.shakaPromise;

      this.dispatchEvent(new Event("shakaloading"));
      this.shakaPromise = new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src =
          "https://cdn.jsdelivr.net/npm/shaka-player/dist/shaka-player.dash.js";
        script.onload = () => {
          this.dispatchEvent(new Event("shakaloaded"));
          resolve(window.shaka);
        };
        script.onerror = (err) => {
          this.dispatchEvent(new Event("shakaloaded"));
          reject(err);
        };
        document.head.appendChild(script);
      });
      return this.shakaPromise;
    }

    connectedCallback() {
      if (this._destroyTimeout) {
        clearTimeout(this._destroyTimeout);
        this._destroyTimeout = null;
      }

      if (this._eventsBound) return;
      this._eventsBound = true;
      const events = [
        "play",
        "playing",
        "waiting",
        "canplay",
        "pause",
        "ended",
        "timeupdate",
        "progress",
        "loadedmetadata",
        "volumechange",
      ];
      events.forEach((evt) => {
        this.video.addEventListener(evt, () => {
          this.dispatchEvent(new Event(evt));
        });
      });
    }

    disconnectedCallback() {
      this._destroyTimeout = setTimeout(() => {
        if (!this.isConnected) {
          this.destroyShaka();
        }
      }, 0);
    }

    async loadVideo(manifestUrl, fallbackUrl) {
      if (!manifestUrl) {
        this.destroyShaka();
        if (fallbackUrl) {
          this.video.src = fallbackUrl;
        }
        return;
      }

      try {
        const shakaLib = await this.getShaka();
        shakaLib.polyfill.installAll();

        if (!shakaLib.Player.isBrowserSupported()) {
          this.destroyShaka();
          if (fallbackUrl) this.video.src = fallbackUrl;
          return;
        }

        if (!this.shakaPlayer) {
          this.shakaPlayer = new shakaLib.Player();
          await this.shakaPlayer.attach(this.video);

          this.shakaPlayer.configure({
            streaming: {
              bufferingGoal: 3600,
              rebufferingGoal: 2,
              bufferBehind: 3600,
            },
          });

          this.shakaPlayer.addEventListener("error", (event) => {
            console.error("Shaka error", event?.detail || event);
          });
        }

        await this.shakaPlayer.load(manifestUrl);
        this.dispatchEvent(new Event("shakaready"));
      } catch (error) {
        console.error("Error loading Shaka player", error);
        this.destroyShaka();
        if (fallbackUrl) this.video.src = fallbackUrl;
      }
    }

    getTracks() {
      if (!this.shakaPlayer) return [];
      return this.shakaPlayer.getVariantTracks();
    }

    selectTrack(id) {
      if (!this.shakaPlayer) return;
      if (id === "auto") {
        this.shakaPlayer.configure({ abr: { enabled: true } });
      } else {
        this.shakaPlayer.configure({ abr: { enabled: false } });
        const tracks = this.shakaPlayer.getVariantTracks();
        const track = tracks.find((t) => t.id == id);
        if (track) {
          this.shakaPlayer.selectVariantTrack(track, true);
        }
      }
    }

    destroyShaka() {
      if (this.shakaPlayer) {
        this.shakaPlayer.destroy();
        this.shakaPlayer = null;
      }
    }

    play() {
      return this.video.play();
    }

    pause() {
      this.video.pause();
    }

    get paused() {
      return this.video.paused;
    }
  }

  if (!customElements.get("dash-video")) {
    customElements.define("dash-video", DashVideo);
  }

  function formatTime(seconds) {
    if (isNaN(seconds)) return "0:00";
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${s.toString().padStart(2, "0")}`;
  }

  function setupVideoPlayers() {
    const players = document.querySelectorAll(".video-player");

    players.forEach((player) => {
      if (player.dataset.initialized === "true") return;
      player.dataset.initialized = "true";

      const dashVideo = player.querySelector("dash-video");
      const video = dashVideo.querySelector("video");

      const centerPlayBtn = player.querySelector(".video-center-play");
      const centerPlayIcon = centerPlayBtn.querySelector(".icon-play-large");
      const centerLoadingIcon = centerPlayBtn.querySelector(
        ".icon-loading-large",
      );

      const playPauseBtn = player.querySelector(".play-pause-btn");
      const iconPlay = playPauseBtn.querySelector(".icon-play");
      const iconPause = playPauseBtn.querySelector(".icon-pause");

      const muteBtn = player.querySelector(".mute-btn");
      const iconVol = muteBtn.querySelector(".icon-volume");
      const iconMuted = muteBtn.querySelector(".icon-muted");

      const fullscreenBtn = player.querySelector(".fullscreen-btn");
      const iconFullscreen = fullscreenBtn.querySelector(".icon-fullscreen");
      const iconFullscreenExit = fullscreenBtn.querySelector(
        ".icon-fullscreen-exit",
      );

      const timelineContainer = player.querySelector(".video-timeline-container");
      const timeline = player.querySelector(".video-timeline");
      const progressBar = player.querySelector(".video-progress-bar");
      const timeCurrent = player.querySelector(".time-current");
      const timeDuration = player.querySelector(".time-duration");

      const volumeSlider = player.querySelector(".video-volume");
      const qualityContainer = player.querySelector(".video-quality-container");
      const qualityBtn = player.querySelector(".video-quality-btn");
      const qualityMenu = player.querySelector(".video-quality-menu");

      const src = player.dataset.src;
      const manifest = player.dataset.manifest;

      let isVideoLoaded = false;
      let hideUiTimeout;

      function triggerUiHiding() {
        clearTimeout(hideUiTimeout);
        player.classList.add("show-ui");
        if (!video.paused) {
          hideUiTimeout = setTimeout(() => {
            player.classList.remove("show-ui");
          }, 3000);
        }
      }

      player.addEventListener("mousemove", triggerUiHiding);
      player.addEventListener("mouseleave", () => {
        if (!video.paused) player.classList.remove("show-ui");
      });

      async function togglePlay() {
        if (!isVideoLoaded) {
          centerPlayIcon.style.display = "none";
          centerLoadingIcon.style.display = "block";

          await dashVideo.loadVideo(manifest, src);
          isVideoLoaded = true;

          centerPlayIcon.style.display = "block";
          centerLoadingIcon.style.display = "none";
        }

        if (video.paused) {
          video.play().catch((e) => console.error("Video play blocked:", e));
        } else {
          video.pause();
        }
      }

      centerPlayBtn.addEventListener("click", togglePlay);
      playPauseBtn.addEventListener("click", togglePlay);
      video.addEventListener("click", togglePlay);

      dashVideo.addEventListener("play", () => {
        iconPlay.style.display = "none";
        iconPause.style.display = "block";
        centerPlayBtn.classList.add("fade-out");
        triggerUiHiding();
      });

      dashVideo.addEventListener("pause", () => {
        iconPlay.style.display = "block";
        iconPause.style.display = "none";
        centerPlayBtn.classList.remove("fade-out");
        player.classList.add("show-ui");
      });

      dashVideo.addEventListener("waiting", () => {
        centerPlayBtn.classList.remove("fade-out");
        centerPlayIcon.style.display = "none";
        centerLoadingIcon.style.display = "block";
      });

      dashVideo.addEventListener("playing", () => {
        centerPlayIcon.style.display = "block";
        centerLoadingIcon.style.display = "none";
        centerPlayBtn.classList.add("fade-out");
      });

      dashVideo.addEventListener("loadedmetadata", () => {
        timeDuration.textContent = formatTime(video.duration);
      });

      function updateProgressAndBuffer() {
        if (!video.duration) return;
        const percent = (video.currentTime / video.duration) * 100;
        timeline.value = percent;
        progressBar.style.setProperty("--progress", `${percent}%`);
        // also set on container so the CSS thumb pseudo-element can read it
        timelineContainer.style.setProperty("--progress", `${percent}%`);

        if (video.buffered.length > 0) {
          let bufEnd = 0;
          for (let i = 0; i < video.buffered.length; i++) {
            if (
              video.buffered.start(i) <= video.currentTime &&
              video.buffered.end(i) >= video.currentTime
            ) {
              bufEnd = video.buffered.end(i);
              break;
            }
          }
          if (bufEnd === 0 && video.buffered.length > 0) {
            bufEnd = video.buffered.end(video.buffered.length - 1);
          }
          const bufPercent = (bufEnd / video.duration) * 100;
          progressBar.style.setProperty("--buffer", `${bufPercent}%`);
        }
      }

      dashVideo.addEventListener("timeupdate", () => {
        timeCurrent.textContent = formatTime(video.currentTime);
        updateProgressAndBuffer();
      });

      dashVideo.addEventListener("progress", updateProgressAndBuffer);

      timeline.addEventListener("input", (e) => {
        if (video.duration) {
          const time = (e.target.value / 100) * video.duration;
          video.currentTime = time;
        }
      });

      function updateVolumeUi() {
        const vol = video.muted ? 0 : video.volume;
        volumeSlider.value = vol;
        volumeSlider.style.setProperty("--vol", `${vol * 100}%`);
        if (video.volume === 0 || video.muted) {
          iconVol.style.display = "none";
          iconMuted.style.display = "block";
        } else {
          iconVol.style.display = "block";
          iconMuted.style.display = "none";
        }
      }

      muteBtn.addEventListener("click", () => {
        video.muted = !video.muted;
        volumeSlider.value = video.muted ? 0 : video.volume;
        updateVolumeUi();
      });

      volumeSlider.addEventListener("input", (e) => {
        video.volume = e.target.value;
        video.muted = video.volume === 0;
        updateVolumeUi();
      });

      dashVideo.addEventListener("volumechange", updateVolumeUi);

      dashVideo.addEventListener("shakaready", () => {
        const tracks = dashVideo.getTracks();
        if (tracks && tracks.length > 0) {
          const seenHeights = new Set();
          const uniqueTracks = tracks
            .filter((t) => {
              if (t.height && !seenHeights.has(t.height)) {
                seenHeights.add(t.height);
                return true;
              }
              return false;
            })
            .sort((a, b) => b.height - a.height);

          if (uniqueTracks.length > 1) {
            qualityMenu.innerHTML = '<li data-value="auto" class="selected">Auto</li>';
            uniqueTracks.forEach((t) => {
              const li = document.createElement("li");
              li.dataset.value = t.id;
              li.textContent = `${t.height}p`;
              qualityMenu.appendChild(li);
            });
            qualityContainer.style.display = "flex";
          }
        }
      });

      qualityBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        qualityMenu.classList.toggle("open");
      });

      qualityMenu?.addEventListener("click", (e) => {
        const li = e.target.closest("li");
        if (!li) return;
        qualityMenu.querySelectorAll("li").forEach((el) => el.classList.remove("selected"));
        li.classList.add("selected");
        qualityBtn.textContent = li.textContent;
        qualityMenu.classList.remove("open");
        dashVideo.selectTrack(li.dataset.value);
      });

      document.addEventListener("click", () => {
        qualityMenu?.classList.remove("open");
      });

      fullscreenBtn.addEventListener("click", () => {
        if (!document.fullscreenElement) {
          player.requestFullscreen().catch((err) => {
            console.error(
              `Error attempting to enable full-screen mode: ${err.message}`,
            );
          });
        } else {
          document.exitFullscreen();
        }
      });

      document.addEventListener("fullscreenchange", () => {
        if (document.fullscreenElement === player) {
          iconFullscreen.style.display = "none";
          iconFullscreenExit.style.display = "block";
        } else {
          iconFullscreen.style.display = "block";
          iconFullscreenExit.style.display = "none";
        }
      });

      player.classList.add("show-ui");

      if (src && !manifest) {
        video.src = src;
      }
    });
  }

  function initVideoPlayers() {
    if ("requestIdleCallback" in window) {
      requestIdleCallback(setupVideoPlayers);
    } else {
      setTimeout(setupVideoPlayers, 1);
    }
  }

  document.addEventListener("DOMContentLoaded", initVideoPlayers);
  document.addEventListener("astro:page-load", initVideoPlayers);
</script>
