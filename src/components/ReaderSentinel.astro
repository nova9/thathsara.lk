---
// Easter egg: tracks which posts the reader has scrolled to the bottom of.
// Sets `localStorage["reader:unlocked"] = "1"` once every visible post is read.
//
// The reward itself lives elsewhere — read `reader:unlocked` from wherever you
// want to render it.
//
// Reward ideas (subtle, on-brand):
// - Footer gold-dot pulse: the `.` in `thathsara.lk` (BaseLayout.astro)
//   already gold; animate it forever once unlocked.
// - Hidden /colophon or /thanks page: only linked for unlocked readers
//   (e.g. the ✦ in the post divider becomes clickable, with a tiny tell).
// - Unlock a new music track appended to the MusicPlayer queue.
// - Retro counter shows "reader #N" instead of plain count.
//
// Playful but tasteful:
// - Konami / arrow-key accent rotation through per-post accentColor values.
// - Handwritten signature SVG + one sentence fades in at post bottom.
// - /guestbook page unlocks (GitHub issues API or Cloudflare worker).

import { getVisiblePosts } from "@/lib/utils";

interface Props {
  postId: string;
}

const { postId } = Astro.props;
const allPostIds = (await getVisiblePosts()).map((p) => p.id);
---

<div
  id="reader-sentinel"
  data-post-id={postId}
  data-all-posts={JSON.stringify(allPostIds)}
  aria-hidden="true"
>
</div>

<script>
  import { addRead, hasReadAll, setUnlocked } from "@/lib/readerState";

  function setup() {
    const sentinel = document.getElementById("reader-sentinel");
    if (!sentinel) return;

    const postId = sentinel.dataset.postId!;
    const allPosts: string[] = JSON.parse(sentinel.dataset.allPosts || "[]");

    new IntersectionObserver((entries, obs) => {
      if (!entries[0].isIntersecting) return;
      addRead(postId);
      if (hasReadAll(allPosts)) setUnlocked();
      obs.disconnect();
    }).observe(sentinel);
  }

  document.addEventListener("astro:page-load", setup);
</script>

<style is:global>
  #egg-sentinel {
    height: 1px;
  }
</style>
