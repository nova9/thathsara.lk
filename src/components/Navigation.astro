---
import { siteConfig } from "@/lib/site";

const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Archive", href: "/" },
  { label: "Tags", href: "/tags/" },
  { label: "About", href: "/about/" },
  { label: "Thoughts", href: "/thoughts/" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="masthead">
  <div class="masthead-eyebrow">Est. 2024 · {siteConfig.subtitle}</div>
  <a href="/" class="masthead-title">
    thathsara<em>.</em>lk
  </a>
  <div class="masthead-rule">
    <hr />✦<hr />
  </div>
</header>

<nav class="nav-bar">
  {navItems.map((item, i) => (
    <>
      {i > 0 && <span class="nav-divider">·</span>}
      <a
        href={item.href}
        class:list={["nav-item", { active: isActive(item.href) }]}
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        {item.label}
      </a>
    </>
  ))}
  <button class="search-toggle" id="search-toggle" aria-label="Toggle search" style={currentPath !== "/" ? "display:none" : ""}>
    <span aria-hidden="true">⌕</span><span class="search-label"> Search</span>
  </button>
</nav>

<div id="search-bar-wrapper" class="search-bar-wrapper" hidden>
  <div class="search-bar-inner">
    <span class="search-icon" aria-hidden="true">⌕</span>
    <input
      id="search-input"
      type="search"
      placeholder="Search dispatches…"
      autocomplete="off"
    />
    <button class="search-esc" id="search-close">esc</button>
  </div>
</div>

<script>
  function setupSearch() {
    const toggle = document.getElementById("search-toggle");
    const wrapper = document.getElementById("search-bar-wrapper");
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const close = document.getElementById("search-close");

    if (!toggle || !wrapper || !input || !close) return;

    function openSearch() {
      wrapper!.hidden = false;
      input!.focus();
    }

    function closeSearch() {
      wrapper!.hidden = true;
      input!.value = "";
      filterCards("");
    }

    function filterCards(query: string) {
      const q = query.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>(".post-card").forEach((card) => {
        const text = (card.dataset.search ?? "").toLowerCase();
        card.style.display = !q || text.includes(q) ? "" : "none";
      });
    }

    toggle.addEventListener("click", () => {
      if (wrapper.hidden) {
        openSearch();
      } else {
        closeSearch();
      }
    });

    close.addEventListener("click", closeSearch);

    input.addEventListener("input", () => filterCards(input.value));

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSearch();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !wrapper.hidden) closeSearch();
    });
  }

  document.addEventListener("astro:page-load", setupSearch);
</script>

<style lang="scss">
  // ── Masthead ─────────────────────────────────────────────────────────────────
  .masthead {
    padding: 2rem 2rem 1.5rem;
    text-align: center;
    position: relative;
  }

  .masthead-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    margin-bottom: 0.75rem;
  }

  .masthead-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-block;

    em {
      font-style: italic;
      color: var(--color-gold);
    }

    @media (hover: hover) {
      &:hover { text-decoration: none; color: var(--color-ink); }
    }
  }

  .masthead-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.2rem auto 0;
    max-width: 400px;
    color: var(--color-gold);
    font-size: 14px;

    hr {
      flex: 1;
      border: none;
      border-top: 1px solid var(--color-rule);
      margin: 0;
    }
  }

  // ── Nav bar ───────────────────────────────────────────────────────────────────
  .nav-bar {
    border-block: 1px solid var(--color-rule);
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 100;
  }

  .nav-item {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink-mid);
    padding: 12px 18px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
    display: inline-block;

    &.active {
      color: var(--color-ink);
      border-bottom-color: var(--color-gold);
      text-decoration: none;
    }

    @media (hover: hover) {
      &:hover {
        color: var(--color-ink);
        border-bottom-color: var(--color-gold);
        text-decoration: none;
      }
    }
  }

  .nav-divider {
    color: var(--color-rule);
    font-size: 14px;
    line-height: 1;
  }

  .search-toggle {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;

    @media (hover: hover) {
      &:hover {
        color: var(--color-ink);
        box-shadow: none;
        background: none;
        transform: translateY(-50%);
      }
    }

    &:focus {
      outline: none;
      color: var(--color-gold);
    }
  }

  // ── Search bar ────────────────────────────────────────────────────────────────
  .search-bar-wrapper {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);

    &[hidden] { display: none; }
  }

  .search-bar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 1rem 2rem;
  }

  .search-icon {
    color: var(--color-ink-light);
    font-size: 16px;
    flex-shrink: 0;
  }

  #search-input {
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--font-size-base);
    color: var(--color-ink);
    flex: 1;
    caret-color: var(--color-gold);
    padding: 0;

    &::placeholder { color: var(--color-ink-light); }

    &:focus { border-color: transparent; box-shadow: none; }
  }

  .search-esc {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    cursor: pointer;
    background: none;
    border: none;
    padding: 4px 8px;
    border: 1px solid var(--color-rule);
    transition: all 0.15s;
    flex-shrink: 0;

    @media (hover: hover) {
      &:hover {
        background: none;
        border-color: var(--color-ink-light);
        box-shadow: none;
        transform: none;
        color: var(--color-ink);
      }
    }
  }

  // ── Mobile ────────────────────────────────────────────────────────────────────
  @media (max-width: 600px) {
    .nav-bar {
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: visible;
      padding: 0 1rem;
      gap: 0;
      scrollbar-width: none;

      &::-webkit-scrollbar { display: none; }
    }

    .nav-item {
      padding: 12px 10px;
      letter-spacing: 0.15em;
    }

    .search-toggle {
      position: static;
      transform: none;
      margin-left: auto;
      flex-shrink: 0;
      padding: 12px 0 12px 6px;
      font-size: 16px;
      line-height: 1;

      @media (hover: hover) {
        &:hover { transform: none; }
      }
    }

    .search-label { display: none; }

    .masthead { padding: 1.5rem 1.25rem 1rem; }
  }
</style>
