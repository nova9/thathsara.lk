---
import { siteConfig } from "@/lib/site";
import dotlottieWasmUrl from "@lottiefiles/dotlottie-web/dotlottie-player.wasm?url";
import MastheadTitle from "./MastheadTitle.astro";

const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Archive", href: "/" },
  { label: "Tags", href: "/tags/" },
  { label: "About", href: "/about/" },
  { label: "Thoughts", href: "/thoughts/" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="masthead">
  <div
    class="masthead-eyebrow"
    data-default={`Est. 2024 · ${siteConfig.subtitle}`}
  >
    Est. 2024 · {siteConfig.subtitle}
  </div>
  <MastheadTitle />
  <div class="masthead-rule">
    <hr />
    <span class="masthead-glyph">
      <a class="glyph-link" aria-label="Colophon" hidden data-dotlottie-wasm={dotlottieWasmUrl}>
        ✦
        <svg class="glyph-sparks" viewBox="-20 -20 40 40" aria-hidden="true">
          <path
            class="glyph-spark glyph-spark--a"
            d="M12,-12 L12.7,-10.3 L14.4,-9.6 L12.7,-8.9 L12,-7.2 L11.3,-8.9 L9.6,-9.6 L11.3,-10.3 Z"
          ></path>
          <path
            class="glyph-spark glyph-spark--b"
            d="M-13,10 L-12.4,11.4 L-11,12 L-12.4,12.6 L-13,14 L-13.6,12.6 L-15,12 L-13.6,11.4 Z"
          ></path>
          <path
            class="glyph-spark glyph-spark--c"
            d="M14,4 L14.5,5.2 L15.7,5.7 L14.5,6.2 L14,7.4 L13.5,6.2 L12.3,5.7 L13.5,5.2 Z"
          ></path>
          <path
            class="glyph-spark glyph-spark--d"
            d="M-6,-14 L-5.5,-12.8 L-4.3,-12.3 L-5.5,-11.8 L-6,-10.6 L-6.5,-11.8 L-7.7,-12.3 L-6.5,-12.8 Z"
          ></path>
          <path
            class="glyph-spark glyph-spark--e"
            d="M5,14 L5.5,15.2 L6.7,15.7 L5.5,16.2 L5,17.4 L4.5,16.2 L3.3,15.7 L4.5,15.2 Z"
          ></path>
        </svg>
      </a>
      <span class="glyph-fallback" aria-hidden="true">✦</span>
    </span>
    <hr />
  </div>
</header>

<div class="nav-banner" id="nav-banner" hidden>
  <span>✦ All posts read. Check why the star sparkles above ✦</span>
</div>

<nav class="nav-bar">
  {
    navItems.map((item, i) => (
      <>
        {i > 0 && <span class="nav-divider">·</span>}
        <a
          href={item.href}
          class:list={["nav-item", { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      </>
    ))
  }
  <button
    class="search-toggle"
    id="search-toggle"
    aria-label="Toggle search"
    style={currentPath !== "/" ? "display:none" : ""}
  >
    <span aria-hidden="true">⌕</span><span class="search-label"> Search</span>
  </button>
</nav>

<div id="search-bar-wrapper" class="search-bar-wrapper" hidden>
  <div class="search-bar-inner">
    <span class="search-icon" aria-hidden="true">⌕</span>
    <input
      id="search-input"
      type="search"
      placeholder="Search dispatches…"
      autocomplete="off"
    />
    <button class="search-esc" id="search-close">esc</button>
  </div>
</div>

<script>
  import { isUnlocked } from "@/lib/readerState";

  function setupSearch() {
    const toggle = document.getElementById("search-toggle");
    const wrapper = document.getElementById("search-bar-wrapper");
    const input = document.getElementById(
      "search-input",
    ) as HTMLInputElement | null;
    const close = document.getElementById("search-close");

    if (!toggle || !wrapper || !input || !close) return;

    function openSearch() {
      wrapper!.hidden = false;
      input!.focus();
    }

    function closeSearch() {
      wrapper!.hidden = true;
      input!.value = "";
      filterCards("");
    }

    function filterCards(query: string) {
      const q = query.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>(".post-card").forEach((card) => {
        const text = (card.dataset.search ?? "").toLowerCase();
        card.style.display = !q || text.includes(q) ? "" : "none";
      });
    }

    toggle.addEventListener("click", () => {
      if (wrapper.hidden) {
        openSearch();
      } else {
        closeSearch();
      }
    });

    close.addEventListener("click", closeSearch);

    input.addEventListener("input", () => filterCards(input.value));

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSearch();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !wrapper.hidden) closeSearch();
    });
  }

  function prefetchColophonAssets(wasmUrl: string | undefined) {
    if (!wasmUrl) return;
    const load = () => {
      fetch(wasmUrl, { priority: "low" } as any).catch(() => {});
    };
    if ("requestIdleCallback" in window) {
      (window as any).requestIdleCallback(load, { timeout: 5000 });
    } else {
      setTimeout(load, 5000);
    }
  }

  function revealColophonLink() {
    const unlocked = isUnlocked();
    const glyph = document.querySelector(".masthead-glyph");
    const link = glyph?.querySelector<HTMLAnchorElement>(".glyph-link");
    const banner = document.getElementById("nav-banner");

    if (unlocked) {
      if (glyph && link) {
        link.href = "/colophon/";
        link.hidden = false;
        glyph.classList.add("masthead-glyph--unlocked");
        prefetchColophonAssets(link.dataset.dotlottieWasm);
      }
      if (banner) banner.hidden = false;
    } else {
      if (glyph && link) {
        link.hidden = true;
        link.removeAttribute("href");
        glyph.classList.remove("masthead-glyph--unlocked");
      }
      if (banner) banner.hidden = true;
    }
  }

  const LATE_PHRASES = [
    "Reading at this hour?",
    "Still awake?",
  ];

  function tuneEyebrow() {
    const el = document.querySelector<HTMLElement>(".masthead-eyebrow");
    if (!el) return;
    const hour = new Date().getHours();
    const isLate = hour >= 1 && hour < 4;
    if (isLate) {
      const idx = Math.floor(Math.random() * LATE_PHRASES.length);
      el.textContent = LATE_PHRASES[idx];
    } else if (el.dataset.default) {
      el.textContent = el.dataset.default;
    }
  }

  document.addEventListener("astro:page-load", setupSearch);
  document.addEventListener("astro:page-load", revealColophonLink);
  document.addEventListener("astro:page-load", tuneEyebrow);
</script>

<style lang="scss">
  // ── Masthead ─────────────────────────────────────────────────────────────────
  .masthead {
    padding: 2rem 2rem 1.5rem;
    text-align: center;
    position: relative;
  }

  .masthead-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    margin-bottom: 0.75rem;
  }

  .masthead-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.2rem auto 0;
    max-width: 400px;
    color: var(--color-gold);
    font-size: 14px;

    hr {
      flex: 1;
      border: none;
      border-top: 1px solid var(--color-rule);
      margin: 0;
    }
  }

  .masthead-glyph {
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transform-origin: center;
  }

  .masthead-glyph--unlocked {
    animation: glyph-drift 6s ease-in-out infinite;
  }

  .glyph-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    color: var(--color-gold);
    text-decoration: none;

    &[hidden] {
      display: none;
    }
  }

  .masthead-glyph--unlocked .glyph-link {
    animation: glyph-shimmer 3.2s ease-in-out infinite;
    will-change: filter, opacity;
  }

  .masthead-glyph--unlocked .glyph-fallback {
    display: none;
  }

  @keyframes glyph-drift {
    0%,
    100% {
      opacity: 0.9;
      transform: scale(1) rotate(0deg);
    }
    40% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
    48% {
      opacity: 1;
      transform: scale(1.35) rotate(12deg);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.1) rotate(-4deg);
    }
    60% {
      opacity: 0.9;
      transform: scale(1) rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead-glyph--unlocked {
      animation: none;
    }
  }

  .glyph-sparks {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 32px;
    height: 32px;
    transform: translate(-50%, -50%);
    overflow: visible;
    pointer-events: none;
  }

  .glyph-spark {
    fill: var(--color-gold);
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: glyph-spark 2s ease-in-out infinite;
  }
  .glyph-spark--a {
    animation-duration: 1.8s;
    animation-delay: 0s;
  }
  .glyph-spark--b {
    animation-duration: 2.3s;
    animation-delay: 0.7s;
  }
  .glyph-spark--c {
    animation-duration: 2s;
    animation-delay: 1.2s;
  }
  .glyph-spark--d {
    animation-duration: 2.6s;
    animation-delay: 0.3s;
  }
  .glyph-spark--e {
    animation-duration: 1.9s;
    animation-delay: 1.5s;
  }

  @keyframes glyph-shimmer {
    0%,
    100% {
      opacity: 0.92;
      filter: drop-shadow(0 0 1.5px rgba(212, 175, 55, 0.7))
        drop-shadow(0 0 6px rgba(212, 175, 55, 0.28))
        drop-shadow(0 0 14px rgba(212, 175, 55, 0.12));
    }
    50% {
      opacity: 1;
      filter: drop-shadow(0 0 2.5px rgba(212, 175, 55, 0.85))
        drop-shadow(0 0 10px rgba(212, 175, 55, 0.4))
        drop-shadow(0 0 22px rgba(212, 175, 55, 0.18));
    }
  }

  // Most of the cycle the spark is invisible; it briefly flashes on, then fades.
  @keyframes glyph-spark {
    0%,
    55%,
    100% {
      opacity: 0;
      transform: scale(0);
    }
    65% {
      opacity: 1;
      transform: scale(1.1);
    }
    75% {
      opacity: 0.6;
      transform: scale(0.8);
    }
    85% {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead-glyph--unlocked .glyph-link,
    .glyph-spark {
      animation: none;
    }
    .glyph-spark {
      opacity: 0.6;
      transform: scale(1);
    }
  }

  // ── Nav banner ────────────────────────────────────────────────────────────────
  .nav-banner {
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: center;
    padding: 8px 1rem;

    &[hidden] {
      display: none;
    }

    a {
      color: var(--color-gold);
      text-decoration: underline;
      text-underline-offset: 2px;

      @media (hover: hover) {
        &:hover {
          color: var(--color-paper);
        }
      }
    }
  }

  // ── Nav bar ───────────────────────────────────────────────────────────────────
  .nav-bar {
    border-block: 1px solid var(--color-rule);
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 100;
  }

  .nav-item {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-ink-mid);
    padding: 12px 18px;
    border-bottom: 2px solid transparent;
    transition:
      color 0.2s,
      border-color 0.2s;
    text-decoration: none;
    display: inline-block;

    &.active {
      color: var(--color-ink);
      border-bottom-color: var(--color-gold);
      text-decoration: none;
    }

    @media (hover: hover) {
      &:hover {
        color: var(--color-ink);
        border-bottom-color: var(--color-gold);
        text-decoration: none;
      }
    }
  }

  .nav-divider {
    color: var(--color-rule);
    font-size: 14px;
    line-height: 1;
  }

  .search-toggle {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;

    @media (hover: hover) {
      &:hover {
        color: var(--color-ink);
        box-shadow: none;
        background: none;
        transform: translateY(-50%);
      }
    }

    &:focus {
      outline: none;
      color: var(--color-gold);
    }
  }

  // ── Search bar ────────────────────────────────────────────────────────────────
  .search-bar-wrapper {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);

    &[hidden] {
      display: none;
    }
  }

  .search-bar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 1rem 2rem;
  }

  .search-icon {
    color: var(--color-ink-light);
    font-size: 16px;
    flex-shrink: 0;
  }

  #search-input {
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--font-size-base);
    color: var(--color-ink);
    flex: 1;
    caret-color: var(--color-gold);
    padding: 0;

    &::placeholder {
      color: var(--color-ink-light);
    }

    &:focus {
      border-color: transparent;
      box-shadow: none;
    }
  }

  .search-esc {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    cursor: pointer;
    background: none;
    border: none;
    padding: 4px 8px;
    border: 1px solid var(--color-rule);
    transition: all 0.15s;
    flex-shrink: 0;

    @media (hover: hover) {
      &:hover {
        background: none;
        border-color: var(--color-ink-light);
        box-shadow: none;
        transform: none;
        color: var(--color-ink);
      }
    }
  }

  // ── Mobile ────────────────────────────────────────────────────────────────────
  @media (max-width: 600px) {
    .nav-bar {
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: visible;
      padding: 0 1rem;
      gap: 0;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .nav-item {
      padding: 12px 10px;
      letter-spacing: 0.15em;
    }

    .search-toggle {
      position: static;
      transform: none;
      margin-left: auto;
      flex-shrink: 0;
      padding: 12px 0 12px 6px;
      font-size: 16px;
      line-height: 1;

      @media (hover: hover) {
        &:hover {
          transform: none;
        }
      }
    }

    .search-label {
      display: none;
    }

    .masthead {
      padding: 1.5rem 1.25rem 1rem;
    }
  }
</style>
