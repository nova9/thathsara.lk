---
// Reconciles the easter-egg unlock flag against the current post list.
// Runs on every page. If `egg:read` no longer covers every visible post
// (e.g. a new post was published), clears `egg:unlocked` so the reward
// stops advertising a claim that isn't true anymore. `egg:read` itself
// is preserved — returning readers don't have to re-scroll old posts.
//
// The earning side lives in EasterEgg.astro (post pages only).

import { getVisiblePosts } from "@/lib/utils";

const allPostIds = (await getVisiblePosts()).map((p) => p.id);
---

<div id="egg-state" data-all-posts={JSON.stringify(allPostIds)} hidden></div>

<script>
  const READ_KEY = "egg:read";
  const UNLOCKED_KEY = "egg:unlocked";

  function reconcile() {
    if (!localStorage.getItem(UNLOCKED_KEY)) return;

    const el = document.getElementById("egg-state");
    if (!el) return;

    const allPosts: string[] = JSON.parse(el.dataset.allPosts || "[]");
    const read: string[] = JSON.parse(localStorage.getItem(READ_KEY) || "[]");

    if (!allPosts.every((id) => read.includes(id))) {
      localStorage.removeItem(UNLOCKED_KEY);
    }
  }

  document.addEventListener("astro:page-load", reconcile);
</script>
