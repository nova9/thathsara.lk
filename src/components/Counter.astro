---
const startTimes = [
  "2026-06-16T15:00:00+05:30",
];

const startTime = startTimes[startTimes.length - 1];
---

<span class="retro-time" id="time-counter" data-start={startTime}>
  00:00:00
</span>

<script>
  let interval: ReturnType<typeof setInterval> | undefined;

  function updateTime() {
    const counterEl = document.getElementById("time-counter");
    if (!counterEl) return;

    // Parse the start time and calculate elapsed seconds
    const startStr =
      counterEl.getAttribute("data-start") || new Date().toISOString();
    const start = new Date(startStr).getTime();
    const diff = Math.max(0, Math.floor((Date.now() - start) / 1000));

    // Format to DD:HH:MM:SS
    const days = Math.floor(diff / 86400)
      .toString()
      .padStart(2, "0");
    const hours = Math.floor((diff % 86400) / 3600)
      .toString()
      .padStart(2, "0");
    const minutes = Math.floor((diff % 3600) / 60)
      .toString()
      .padStart(2, "0");
    const seconds = (diff % 60).toString().padStart(2, "0");

    counterEl.innerText = `${days}:${hours}:${minutes}:${seconds}`;
  }

  document.addEventListener("astro:page-load", () => {
    updateTime();
    interval = setInterval(updateTime, 1000);
  });

  document.addEventListener("astro:before-swap", () => {
    if (interval) clearInterval(interval);
  });
</script>

<style lang="scss">
  .retro-time {
    display: inline;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
  }
</style>
