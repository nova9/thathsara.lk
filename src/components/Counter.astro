---
const startTimes = [
  "2026-07-28T02:35:00+05:30",
];

const startTime = startTimes[startTimes.length - 1];
---

<time-counter data-start={startTime} class="retro-time">00:00:00</time-counter>

<script>
  class TimeCounter extends HTMLElement {
    #interval?: ReturnType<typeof setInterval>;

    connectedCallback() {
      this.#update();
      this.#interval = setInterval(() => this.#update(), 1000);
    }

    disconnectedCallback() {
      clearInterval(this.#interval);
    }

    #update() {
      const start = new Date(
        this.dataset.start || new Date().toISOString()
      ).getTime();
      const diff = Math.max(0, Math.floor((Date.now() - start) / 1000));
      const p = (n: number) => Math.floor(n).toString().padStart(2, "0");
      this.textContent = `${p(diff / 86400)}:${p((diff % 86400) / 3600)}:${p((diff % 3600) / 60)}:${p(diff % 60)}`;
    }
  }

  if (!customElements.get("time-counter")) {
    customElements.define("time-counter", TimeCounter);
  }
</script>

<style lang="scss">
  .retro-time {
    display: inline;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
  }
</style>
