---
interface Props extends astroHTML.JSX.SVGAttributes {
  class?: string;
  width?: string | number;
  height?: string | number;
}

const { class: className, width = "24", height = "24", ...rest } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={width}
  height={height}
  stroke="currentColor"
  stroke-width="2"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...rest}
>
  <line x1="18" y1="6" x2="6" y2="18"></line>
  <line x1="6" y1="6" x2="18" y2="18"></line>
</svg>
