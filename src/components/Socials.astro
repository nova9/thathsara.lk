---
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import InstagramIcon from "@/components/icons/InstagramIcon.astro";

const socials = [
  {
    name: "GitHub",
    url: "https://github.com/nova9",
    icon: GitHubIcon,
  },
  {
    name: "Instagram",
    url: "https://www.instagram.com/_.thathsara",
    icon: InstagramIcon,
  },
];
---

<div class="footer-links">
  {
    socials.map((social, index) => {
      const SocialIcon = social.icon;
      return (
        <>
          <a class="soc" href={social.url} rel="me" title={social.name} target="_blank">
            {SocialIcon ? <SocialIcon class="soc-icon" /> : null}
            <span>{social.name}</span>
          </a>
          {index < socials.length - 1 && <span class="divider">•</span>}
        </>
      );
    })
  }
</div>
