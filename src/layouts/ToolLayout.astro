---
// Standalone, app-like layout for browser tools. Deliberately unrelated to the
// editorial site chrome: own palette, own shell, no masthead/footer/music.
import { siteConfig } from "@/lib/site";
import { toolTheme, toolThemeCss } from "@/lib/toolTheme";
import HeadMeta from "@/components/HeadMeta.astro";
import Analytics from "@/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  icon?: string;
  keywords?: string[];
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  icon = "🧮",
  keywords,
  image = "/favicon.png",
  structuredData,
} = Astro.props;
const pageTitle = title ? `${title} · Tools` : "Tools";
const pageDescription = description ?? "Small tools that run in your browser.";
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const siteURL = Astro.site ?? canonicalURL;
const socialImageURL = siteURL ? new URL(image, siteURL) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadMeta
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      siteName={siteConfig.title}
      canonicalURL={canonicalURL}
      siteURL={siteURL}
      socialImageURL={socialImageURL}
      keywords={keywords}
      themeColorLight={toolTheme.light.accent}
      themeColorDark={toolTheme.dark.bg}
      ogImageSize
      structuredData={structuredData}
    />
    <Analytics />
  </head>

  <body>
    <div class="app">
      <header class="app__bar">
        <a class="app__back" href="/tools/" aria-label="All tools">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M15 18l-6-6 6-6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Tools</span>
        </a>
        <a class="app__brand" href="/" title={siteConfig.title}>
          thathsara<span>.lk</span>
        </a>
      </header>

      <main class="app__main">
        <slot />
      </main>

      <footer class="app__foot">
        Runs entirely in your browser. Nothing is sent to a server.
      </footer>
    </div>

    <!-- Color tokens come from src/lib/toolTheme.js (shared with the OG cards). -->
    <style is:global set:html={toolThemeCss()}></style>

    <style is:global>
      :root {
        --t-radius: 16px;
        --t-radius-sm: 10px;
        --t-font: var(--font-dm-sans), system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        font-family: var(--t-font);
        color: var(--t-text);
        background: var(--t-bg);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .app {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      .app__bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 1.25rem;
        max-width: 720px;
        width: 100%;
        margin: 0 auto;
      }

      .app__back {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--t-muted);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        padding: 0.35rem 0.6rem 0.35rem 0.4rem;
        border-radius: 999px;
        transition: background 0.15s, color 0.15s;
      }
      .app__back:hover {
        color: var(--t-accent);
        background: var(--t-accent-soft);
      }

      .app__brand {
        font-size: 14px;
        font-weight: 500;
        color: var(--t-faint);
        text-decoration: none;
      }
      .app__brand span {
        color: var(--t-accent);
      }

      .app__main {
        flex: 1;
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
        padding: 0.5rem 1.25rem 3rem;
      }

      .app__foot {
        text-align: center;
        color: var(--t-faint);
        font-size: 12.5px;
        padding: 1.5rem 1.25rem 2.5rem;
      }
    </style>

    <script is:inline>
      // Keep the OS theme-color in sync if the tool itself sets an accent later.
    </script>
  </body>
</html>
