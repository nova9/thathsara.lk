---
import { siteConfig } from "@/lib/site";
import packageJson from "../../package.json";
import "../styles/main.scss";
import HeadMeta from "@/components/HeadMeta.astro";
import Analytics from "@/components/Analytics.astro";
import Navigation from "@/components/nav/Navigation.astro";
import ReaderState from "@/components/reader/ReaderState.astro";
import MusicPlayer from "@/components/media/MusicPlayer.astro";
import RetroCounter from "@/components/Counter.astro";
import { ClientRouter } from "astro:transitions";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import InstagramIcon from "@/components/icons/InstagramIcon.astro";

interface Props {
  title?: string;
  description?: string;
  accentColor?: string;
  image?: string;
}

const { title, description, accentColor, image = "/favicon.svg" } = Astro.props;
const pageTitle = title
  ? `${title} — ${siteConfig.title}`
  : `${siteConfig.title}`;
const pageDescription = description ?? siteConfig.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site ? new URL("/", Astro.site) : new URL("/", canonicalURL);
const socialImageURL = new URL(image, siteURL);
const themeColor = accentColor ?? "#b8882a";
const currentYear = new Date().getFullYear();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL.toString(),
      name: siteConfig.title,
      description: siteConfig.description,
      inLanguage: "en",
      publisher: { "@id": `${siteURL}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteURL}#person`,
      name: siteConfig.title,
      url: siteURL.toString(),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <HeadMeta
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      siteName={siteConfig.title}
      canonicalURL={canonicalURL}
      siteURL={siteURL}
      socialImageURL={socialImageURL}
      themeColor={themeColor}
      structuredData={structuredData}
    />
    <Analytics spa />

    <ClientRouter />

    <style is:global>
      html.is-loading body::before,
      html.is-loaded body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        background-color: var(--color-gold, #b8882a);
        z-index: 99999;
        pointer-events: none;
      }
      html.is-loading body::before {
        animation: route-loading 10s ease-out forwards;
        opacity: 1;
      }
      html.is-loaded body::before {
        animation: route-loaded 0.4s ease-out forwards;
      }
      @keyframes route-loading {
        0%   { width: 0%; }
        10%  { width: 20%; }
        50%  { width: 50%; }
        100% { width: 80%; }
      }
      @keyframes route-loaded {
        0%   { width: 80%; opacity: 1; }
        50%  { width: 100%; opacity: 1; }
        100% { width: 100%; opacity: 0; }
      }
    </style>

    <script is:inline>
      document.addEventListener('astro:before-preparation', () => {
        document.documentElement.classList.add('is-loading');
        document.documentElement.classList.remove('is-loaded');
      });
      document.addEventListener('astro:before-swap', (e) => {
        const incoming = e.newDocument.body.getAttribute('style');
        if (incoming) {
          document.body.setAttribute('style', incoming);
        } else {
          document.body.removeAttribute('style');
        }
      });
      document.addEventListener('astro:page-load', () => {
        if (document.documentElement.classList.contains('is-loading')) {
          document.documentElement.classList.remove('is-loading');
          document.documentElement.classList.add('is-loaded');
          setTimeout(() => {
            document.documentElement.classList.remove('is-loaded');
          }, 400);
        }
      });
      // Safety net: a navigation to a non-HTML resource (e.g. a PDF) leaves
      // 'is-loading' set without ever firing astro:page-load. Clear it when the
      // page is shown again, including bfcache restores on back-navigation.
      window.addEventListener('pageshow', () => {
        document.documentElement.classList.remove('is-loading', 'is-loaded');
      });
    </script>
  </head>

  <body
    style={accentColor
      ? `--color-primary: ${accentColor}; --color-border: ${accentColor};`
      : undefined}
  >
    <!-- Reconciles per-reader localStorage state before Nav/PostCard read it -->
    <ReaderState />

    <!-- Full-width navigation: masthead + nav bar + search -->
    <Navigation />

    <!-- Page content (max-width 760px centered) -->
    <main class="page-content">
      <slot />
    </main>

    <!-- Full-width footer -->
    <footer class="site-footer">
      <div class="footer-links">
        <a class="soc" href="https://github.com/nova9" rel="me" title="GitHub" target="_blank">
          <GitHubIcon class="soc-icon" />
          <span>GitHub</span>
        </a>
        <span class="divider">·</span>
        <a class="soc" href="https://www.instagram.com/_.thathsara" rel="me" title="Instagram" target="_blank">
          <InstagramIcon class="soc-icon" />
          <span>Instagram</span>
        </a>
      </div>
      <div class="footer-info">
        thathsara<span style="color: var(--color-gold)">.</span>lk
        &nbsp;·&nbsp; dispatches from the edge
        &nbsp;·&nbsp; {currentYear}
        &nbsp;·&nbsp; <a href="/settings/">Settings</a>
        &nbsp;·&nbsp; <a href="https://astro.build" target="_blank">Astro</a>
        &nbsp;·&nbsp; v{packageJson.version}
        &nbsp;·&nbsp; <RetroCounter />
      </div>
    </footer>

    <MusicPlayer />
  </body>
</html>
